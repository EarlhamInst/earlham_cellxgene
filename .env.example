# CellXGene Explorer Configuration
# Copy this file to .env and adjust values as needed

# =================================================================
# Data Storage (container paths - usually don't need to change)
# =================================================================
DATA_DIRECTORY=/data/datasets
LOG_DIRECTORY=/data/logs

# =================================================================
# Host Paths (for volume mounting)
# Set these to the absolute paths on your host machine
# =================================================================
# Development (relative paths)
# HOST_DATA_DIRECTORY=./data/datasets
# HOST_PRIVATE_DATA_DIRECTORY=./data/private
# HOST_LOG_DIRECTORY=./data/logs

# Production (using /mnt/data as root)
HOST_DATA_DIRECTORY=/mnt/data/datasets
HOST_PRIVATE_DATA_DIRECTORY=/mnt/data/private
HOST_LOG_DIRECTORY=/mnt/data/logs

# Service Ports
LANDING_PAGE_PORT=8000
CELLXGENE_PORT=5005
NGINX_PORT=80

# CellXGene Configuration
# Recommended for VM: 16 cores, 48GB RAM
CELLXGENE_WORKERS=10
CELLXGENE_MEMORY_PER_WORKER_GB=4
CELLXGENE_TIMEOUT_SECONDS=300

# Landing Page Configuration
LANDING_PAGE_DEBUG=false
LANDING_PAGE_LOG_LEVEL=INFO

# =================================================================
# Admin Authentication (REQUIRED for production)
# =================================================================
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Public base URL — used to build shareable links and post-share redirects.
# Must match the URL users hit in the browser. No trailing slash.
# Example (prod): http://ei-cellxgene-explorer-prod.cyverseuk.org
BASE_URL=

# Nginx Configuration
NGINX_CLIENT_MAX_BODY_SIZE=10G
NGINX_PROXY_READ_TIMEOUT=300s

# Optional: Enable hot-reload for dataset changes
ENABLE_HOT_RELOAD=false
HOT_RELOAD_INTERVAL_SECONDS=60
